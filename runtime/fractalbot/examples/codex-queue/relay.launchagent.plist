<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.fractalmind.codex-queue-relay</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/absolute/path/to/project/scripts/codex_queue_relay.py</string>
  </array>
  <key>WorkingDirectory</key><string>/absolute/path/to/project</string>
  <key>RunAtLoad</key><true/>
  <key>WatchPaths</key>
  <array><string>/Users/you/.fractalbot/codex-queue/inbox</string></array>
  <key>StartInterval</key><integer>30</integer>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>/Users/you/.fractalbot/codex-queue/logs/stdout.log</string>
  <key>StandardErrorPath</key><string>/Users/you/.fractalbot/codex-queue/logs/stderr.log</string>
</dict>
</plist>
