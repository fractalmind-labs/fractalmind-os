<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.fractalmind.typemind">

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.TypeMind">

        <activity
            android:name=".SettingsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TypeMindImeService"
            android:exported="true"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/ime" />
        </service>

        <receiver
            android:name=".AiInputReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="ai.input.TEXT" />
                <action android:name="ai.input.SEND" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".AiInputReceiverDebug"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="ai.input.TEXT" />
                <action android:name="ai.input.SEND" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
