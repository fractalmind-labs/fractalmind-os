{
  "name": "@fractalmind-labs/fractalmind-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only FractalMind Agent CLI",
  "type": "module",
  "bin": {
    "fm": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "tsx src/index.ts",
    "localnet": "tsx scripts/agent-cli-localnet.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fractalmind-labs/fractalmind-sdk": "file:../../protocols/fractalmind-protocol/sdk",
    "@mysten/sui": "2.33.1",
    "keytar": "7.9.0"
  },
  "devDependencies": {
    "@types/node": "20.19.38",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
