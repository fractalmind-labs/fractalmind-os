{
  "name": "@fractalmind-labs/fractalmind-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for FractalMind Protocol on Sui",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "tsx --test tests/*.test.ts",
    "smoke:rpc": "tsx scripts/rpc-smoke.ts"
  },
  "dependencies": {
    "@mysten/sui": "2.33.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "type": "module"
}
